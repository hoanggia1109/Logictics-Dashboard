# ───────── Bắt buộc ─────────
# Tên miền trỏ về máy chủ này (cần bản ghi DNS loại A). Caddy dùng nó để xin chứng chỉ HTTPS.
DOMAIN=fo.example.com

# ───────── Tài khoản Quản trị đầu tiên (chỉ dùng ở lần chạy đầu, khi chưa có Quản trị nào) ─────────
# Để trống ADMIN_PASS: hệ thống tự sinh mật khẩu tạm, in ra log và lưu ở /data/first-login.txt.
# Dù cách nào, lần đăng nhập đầu cũng bị bắt đổi mật khẩu. Quản trị tạo tiếp Logistic Lead, Tech Lead, Head of Sale;
# mỗi Lead tự tạo tài khoản cho người trong team mình. (LEAD_USER / LEAD_PASS của bản Rider Live cũ vẫn được hiểu.)
ADMIN_USER=admin
ADMIN_PASS=

# ───────── Điều khoản xử lý dữ liệu của FO ─────────
# Tên công ty và đầu mối liên hệ hiện trong điều khoản mặc định (Lead sửa toàn văn được trong mục Tài khoản → Điều khoản FO).
COMPANY_NAME=Atlas Capture Việt Nam
PRIVACY_CONTACT=

# ───────── Lưu dữ liệu ─────────
# Số ngày giữ lịch sử vị trí / ảnh và hồ sơ giao nhận. 0 = giữ mãi. Nhớ khớp với điều khoản FO đã đồng ý.
RETENTION_DAYS=30
PHOTO_RETENTION_DAYS=180
# Số ngày một lần đăng nhập còn hiệu lực nếu không dùng.
SESSION_DAYS=30

# ───────── Bản đồ ─────────
# Chạy thật nên dùng nền Google chính thức (mục "Nền bản đồ Google chính thức" bên dưới); khi đó TILE_URL không còn được dùng.
# Chưa có khoá thì dùng nền này. Mặc định: Google Maps đường phố (https://mt1.google.com/vt/lyrs=m&x={x}&y={y}&z={z}) — địa chỉ này
# KHÔNG có giấy phép sử dụng chính thức, chỉ hợp để thử; không được vẽ đường đi lấy từ Google Routes API lên nền khác ngoài Google.
# Tuỳ chọn khác:
# - Google Maps Vệ tinh (Hybrid): https://mt1.google.com/vt/lyrs=y&x={x}&y={y}&z={z}
# - OpenStreetMap: https://tile.openstreetmap.org/{z}/{x}/{y}.png (máy chủ công cộng, chỉ dùng nội bộ lưu lượng thấp)
# TILE_URL=https://mt1.google.com/vt/lyrs=m&x={x}&y={y}&z={z}
# TILE_ATTRIBUTION=© Google Maps

# ───────── Vị trí ─────────
# Quá STALE_SEC giây không có điểm mới → "Mất sóng"; quá OFFLINE_SEC → tự đóng ca; quá LOST_ALERT_SEC khi đang chạy task → cảnh báo.
STALE_SEC=45
OFFLINE_SEC=600
LOST_ALERT_SEC=180
# FO vào trong bán kính này (mét) của điểm → tự ghi "đã đến" (mỗi điểm chỉnh riêng được). Xác nhận khi ở xa hơn FAR_PROOF_M → gắn cờ.
ARRIVE_RADIUS_M=120
FAR_PROOF_M=400
# Múi giờ của hệ thống tính bằng phút lệch so với UTC (Việt Nam = 420).
TZ_OFFSET_MIN=420

# ───────── SLA ─────────
# Có đường đi thực tế (mục "Đường đi thực tế & giao thông" ngay dưới): SLA gốc = thời gian chạy xe theo đường thật (từng chặng nhân
#   hệ số đã học theo giờ cao điểm / thấp điểm) + thời gian dừng điển hình ở từng điểm (học từ lịch sử; chưa đủ thì SLA_STOP_MIN phút,
#   điểm BO phải xác nhận thêm 2 phút) + dự phòng theo độ bất định của chuyến (xem SLA_TARGET_PCT bên dưới), làm tròn lên 5 phút.
# Dự phòng khi chưa có đường thật (tắt, đang tính, lỗi, hết lượt gọi): SLA gốc = quãng chim bay × SLA_ROAD_FACTOR ÷ SLA_SPEED_KMH
#   + SLA_STOP_MIN phút mỗi điểm + SLA_BUFFER_MIN phút, làm tròn lên 5 phút.
# Hạn thực tế = SLA gốc × hệ số thời tiết × hệ số giao thông (tối đa ×2). Đường thật đã tính giao thông (Google) thì không nhân thêm
# hệ số giờ cao điểm tự động (tránh tính kẹt xe hai lần); chỉ nhân khi Logistic tự chọn mức giao thông. Nên chỉnh lại sau 1–2 tuần chạy thật.
SLA_SPEED_KMH=22
SLA_ROAD_FACTOR=1.35
SLA_STOP_MIN=6
SLA_BUFFER_MIN=10
# Mục tiêu % chuyến kịp hạn khi SLA tính theo đường thật (50–99). Càng cao thì dự phòng càng rộng: 85 là mức cân bằng, 90 cho khách khó tính.
SLA_TARGET_PCT=85
# Độ dao động giả định của thời gian chạy xe: từng chặng (0,30 = ±30 %) và cả ngày (0,12 = ±12 %, ví dụ mưa cả buổi). Hệ thống tự hiệu chỉnh
# dự phòng theo lịch sử khi có từ 100 chuyến đã chạy theo đường thật; trước đó dùng đúng hai số này.
SLA_SIGMA_LEG=0.30
SLA_SIGMA_DAY=0.12
# Dự phòng = max(SLA_BUFFER_FLOOR, SLA_BUFFER_BASE + phần theo độ bất định), tính bằng phút.
SLA_BUFFER_BASE=3
SLA_BUFFER_FLOOR=5
# 1 = tự học từ task đã xong trong 30 ngày gần nhất: thời gian dừng thật ở từng điểm, độ lệch giữa giờ chạy thật với giờ dịch vụ
# tính đường dự báo, và mức dự phòng cần để đạt SLA_TARGET_PCT. 0 = tắt, chỉ dùng các số cố định ở trên.
SLA_CALIBRATE=1

# ───────── Đường đi thực tế & giao thông (tuỳ chọn) ─────────
# Bật lên thì mỗi task của FO được tính đường đi thật theo đường phố: vẽ lên bản đồ (Logistic, app FO, link BO) và SLA tính theo
# thời gian chạy xe thật. Tạo/sửa task không phải chờ: có ngay SLA ước tính, vài giây sau tự cập nhật theo đường thật.
# Chỉ gửi toạ độ các điểm giao nhận (cửa hàng, văn phòng). Vị trí GPS của FO KHÔNG BAO GIỜ được gửi cho Google hay OSRM.
# google = Google Routes API (có kẹt xe trực tiếp và dự báo, tính phí) · osrm = máy chủ OSRM (miễn phí, không có giao thông) · none = tắt.
ROUTING_PROVIDER=none
# Khoá Google Maps: chỉ máy chủ giữ, không gửi xuống trình duyệt, không ghi ra log. Cách lấy:
#   1. Vào console.cloud.google.com, tạo (hoặc chọn) một dự án và gắn tài khoản thanh toán (Billing).
#   2. APIs & Services → Library → tìm "Routes API" → Enable.
#   3. APIs & Services → Credentials → Create credentials → API key.
#   4. Mở khoá vừa tạo: Application restrictions = IP addresses → nhập IP công khai của máy chủ này;
#      API restrictions = Restrict key → chỉ tick "Routes API" → Save. Lộ khoá thì người khác cũng không dùng được.
#   5. Billing → Budgets & alerts: đặt ngân sách tháng kèm email cảnh báo. Muốn chặn hẳn hoá đơn bất ngờ: APIs & Services →
#      Routes API → Quotas → hạ số yêu cầu mỗi ngày / mỗi phút cho vừa nhu cầu.
# Giá tham khảo (bảng giá Google 10/2026 — xem lại trước khi dùng): xe máy hoặc tô màu kẹt xe tính mức Enterprise ~15 USD/1.000 lần,
# 1.000 lần đầu mỗi tháng miễn phí; ô tô có giao thông mức Pro ~10 USD/1.000 lần, 5.000 lần miễn phí. Mỗi lần xem trước, tạo hoặc sửa
# task thường tốn 1 lần gọi (tuyến giống hệt trong vài phút thì dùng lại); sát giờ đi và lúc FO bắt đầu chạy có thể tính lại theo giao thông.
# Điều khoản Google: đường đi lấy từ Google chỉ được vẽ trên bản đồ Google (giữ TILE_URL mặc định) và chỉ được lưu tạm tối đa 30 ngày.
GOOGLE_MAPS_API_KEY=
# Phương tiện: TWO_WHEELER = xe máy (mặc định; Google hỗ trợ ở Việt Nam, đang thử nghiệm) · DRIVE = ô tô.
# Tuyến nào Google chưa hỗ trợ xe máy thì tự tính lại theo ô tô và ghi chú trên tuyến.
ROUTING_MODE=TWO_WHEELER
# TRAFFIC_AWARE = tính cả giao thông (mặc định) · TRAFFIC_AWARE_OPTIMAL = sát hơn nhưng chậm hơn · TRAFFIC_UNAWARE = bỏ qua giao thông.
ROUTING_PREF=TRAFFIC_AWARE
# 1 = tô màu đoạn đường chậm (cam) và kẹt (đỏ) trên bản đồ. Với ô tô, đặt 0 để Google tính giá mức Pro thay vì Enterprise.
ROUTING_TRAFFIC_LINES=1
# Tối đa số lần gọi dịch vụ tính đường mỗi ngày (theo giờ Việt Nam); hết lượt thì task mới dùng SLA ước tính tới hết ngày. 0 = không giới hạn.
ROUTING_DAILY_LIMIT=1500
# Chờ dịch vụ tính đường tối đa ngần này mili giây; quá thì giữ SLA ước tính.
ROUTING_TIMEOUT_MS=8000
# OSRM: miễn phí, dùng bản đồ OpenStreetMap, không có dữ liệu giao thông (SLA vẫn nhân hệ số giờ cao điểm như trước). Tự dựng bằng Docker
# image osrm/osrm-backend với bản đồ Việt Nam (vietnam-latest.osm.pbf trên download.geofabrik.de) rồi điền địa chỉ, ví dụ http://osrm:5000.
# Máy chủ công cộng https://router.project-osrm.org CHỈ để thử: không dùng cho việc kinh doanh, tối đa 1 lần gọi/giây, không cam kết hoạt động.
# OSRM_URL=http://osrm:5000
# OSRM_PROFILE=driving
# Số ngày giữ đường đi đã tính của task đã đóng. 0 = giữ mãi. Dùng Google thì tối đa 30 (điều khoản), đặt khác sẽ tự về 30.
ROUTE_RETENTION_DAYS=30

# ───────── Nền bản đồ Google chính thức (Map Tiles API, tuỳ chọn) ─────────
# Có khoá thì mọi bản đồ (Logistic, app FO, link BO) dùng ô bản đồ Google chính thức, nhãn tiếng Việt, biên giới theo góc nhìn Việt Nam,
# kèm logo Google và dòng bản quyền theo khung nhìn như Google yêu cầu. Bắt buộc khi ROUTING_PROVIDER=google (đường của Google chỉ được vẽ
# trên bản đồ Google). Giá tham khảo (10/2026, xem lại trước khi dùng): 0,60 USD / 1.000 ô, 100.000 ô miễn phí mỗi tháng; ước lượng
# 30 FO + 10 người điều phối ≈ 150.000–450.000 ô/tháng. Hạn mức MẶC ĐỊNH chỉ 15.000 ô/NGÀY (vượt là bản đồ trắng) → xin nâng ngay.
# Đây là khoá TRÌNH DUYỆT (nằm trong địa chỉ ô bản đồ), khác với GOOGLE_MAPS_API_KEY ở trên. Cách lấy:
#   1. Cùng dự án Google Cloud ở trên: APIs & Services → Library → "Map Tiles API" → Enable.
#   2. Credentials → Create credentials → API key. Mở khoá: Application restrictions = Websites → thêm https://<tên miền của PUBLIC_URL>/*;
#      API restrictions = Restrict key → chỉ tick "Map Tiles API". Lộ khoá thì trang khác cũng không dùng được.
#   3. Map Tiles API → Quotas → nâng "2D tiles per day" (đề xuất 40.000) và đặt ngân sách tháng kèm cảnh báo (Billing → Budgets).
# Cần PUBLIC_URL đúng tên miền (máy chủ gửi kèm Referer đó khi tạo phiên). Phiên tự làm mới mỗi 24 giờ; lỗi thì bản đồ tạm dùng TILE_URL.
GOOGLE_MAPS_TILES_KEY=

# ───────── BO xác nhận qua link dùng một lần ─────────
# 1 = FO giao nhận xong tại điểm loại "BO" thì BO phải xác nhận (kèm ảnh) trên link do Logistic gửi, FO mới đi tiếp được. 0 = tắt.
BO_CONFIRM=1
# BO chưa xác nhận sau ngần này phút → báo khẩn cho Logistic (FO đang phải đứng chờ).
BO_REMIND_MIN=5
# Link của BO tự hết hạn sau ngần này giờ kể từ lúc tạo.
BO_LINK_HOURS=48

# ───────── Thời tiết tự động (tuỳ chọn) ─────────
# 1 = lấy lượng mưa hiện tại từ Open-Meteo mỗi 10 phút để tự nới SLA. LƯU Ý: gói miễn phí của Open-Meteo chỉ cho mục đích
# phi thương mại; dùng trong doanh nghiệp cần gói trả phí của họ (đặt WEATHER_URL kèm khoá) hoặc để 0 và chỉnh tay.
WEATHER_AUTO=0
# WEATHER_URL=
# WEATHER_LAT=10.7769
# WEATHER_LON=106.7009

# ───────── Sao lưu tự động ─────────
# Mỗi ngày lúc BACKUP_HOUR giờ (giờ Việt Nam) chép toàn bộ dữ liệu ra /data/backups/atlas-YYYYMMDD-HHMM.db, giữ BACKUP_KEEP bản.
# Ảnh giao nhận ở /data/photos không nằm trong tệp sao lưu. Nhớ chép cả thư mục /data ra ngoài máy chủ theo lịch riêng.
BACKUP_HOUR=2
BACKUP_KEEP=14

# ───────── Slack (tuỳ chọn) ─────────
# Dán Incoming Webhook URL để đẩy cảnh báo khẩn (trễ hạn, mất tín hiệu, BO báo lệch, FO báo sự cố…) vào một kênh Slack.
SLACK_WEBHOOK_URL=

# ───────── Xem thử ─────────
# 1 = tạo dữ liệu mẫu + FO giả tự chạy (tài khoản lead/log/fo/bo, mật khẩu demo1234). CHỈ bật trên máy thử, dữ liệu trống.
DEMO=0
